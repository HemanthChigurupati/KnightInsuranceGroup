# Copy to .env, uncomment ONE option and fill in your own model and key. Never commit .env.
# No model is preconfigured: without one the app still runs, shows extraction and the
# summary as failed with the reason, and still runs the deterministic checks.

# --- Option 1: Claude via the Anthropic API ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# Claude only: low | medium | high | xhigh | max
# LLM_EFFORT=medium

# --- Option 2: any OpenAI-compatible server (OpenAI, Gemini, Ollama, LM Studio, vLLM, Groq, OpenRouter, ...) ---
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=
# LLM_BASE_URL=
# Leave LLM_API_KEY empty for local servers that need no key
# LLM_API_KEY=

# Seconds per model call
LLM_TIMEOUT_SECONDS=60
