{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app (http://127.0.0.1:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Live check on samples (real API calls)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.live_extract",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ]
}
